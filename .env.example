# MongoDB Connection String (Atlas or local)
# SECURITY: Keep the actual .env file in .gitignore
MONGO_URI=mongodb://localhost:27017

# NGROK Configuration (optional, for production/testing with ngrok)
# Only set this if you're using ngrok for tunneling
# Example: renovate-overfull-outgoing.ngrok-free.dev
VITE_NGROK_HOST=

# Gin Framework Mode (release, debug)
GIN_MODE=release

# ML Service URL (for local development)
# ML_SERVICE_URL=http://localhost:8000/v1/predict
